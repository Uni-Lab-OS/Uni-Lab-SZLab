<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Individual S04 magnetic-stirrer module (单独磁搅模块).
       CAD hot-plate (the model center) sits at (-0.225, +0.050) — i.e. +50 mm in Y from
       the rack bottom center, which shares the same CAD origin as the rack.
       device_link uses PLR lower-left-bottom; the plate lands at (0.108914, 0.226618,
       0.122121) in device_link, and the beaker seat sits on it. -->
  <xacro:macro name="szlab_mixer_stirrer" params="parent_link:='' station_name:='' device_name:='' x:=0 y:=0 z:=0 rx:=0 ry:=0 r:=0 mesh_path:=''">
    <joint name="${station_name}${device_name}base_link_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${rx} ${ry} ${r}"/>
      <parent link="${parent_link}"/>
      <child link="${station_name}${device_name}device_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <link name="${station_name}${device_name}device_link"/>
    <joint name="${station_name}${device_name}device_link_joint" type="fixed">
      <!-- PLR lower-left-bottom of the CAD bbox. -->
      <origin xyz="0.33391374 0.17660786 -0.008" rpy="0 0 0"/>
      <parent link="${station_name}${device_name}device_link"/>
      <child link="${station_name}${device_name}base_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <link name="${station_name}${device_name}base_link">
      <inertial>
        <origin xyz="-0.225338277133257 -0.00110785614684515 0.0139081948746832" rpy="0 0 0"/>
        <mass value="0.0808795174685058"/>
        <inertia ixx="1.01374773273621E-05" ixy="-3.78864870740827E-22" ixz="1.53792985157028E-21" iyy="1.01374773273621E-05" iyz="5.86569718155341E-21" izz="1.80459170576023E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://${mesh_path}/meshes/base_link.stl"/>
        </geometry>
        <material name="">
          <color rgba="0.698039215686274 0.698039215686274 0.698039215686274 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://${mesh_path}/meshes/base_link.stl"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
