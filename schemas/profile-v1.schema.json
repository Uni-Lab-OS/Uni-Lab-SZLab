{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni-lab.local/schemas/profile-v1.schema.json",
  "title": "Uni-Lab workstation ProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "device_spec",
    "default_device_binding",
    "resource_topology",
    "driver_config"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "description": { "type": "string" },
    "device_spec": { "type": "string", "minLength": 1 },
    "default_device_binding": { "$ref": "#/$defs/deviceBinding" },
    "resource_topology": { "$ref": "#/$defs/resourceTopology" },
    "driver_config": { "$ref": "#/$defs/driverConfig" },
    "recipe_import_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
      }
    },
    "recipe_import_resource_holds": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipeImportResourceHold" }
    },
    "workflow_importers": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowImporter" }
    }
  },
  "$defs": {
    "deviceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "driver_key", "connection_ref"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "driver_key": { "type": "string", "minLength": 1 },
        "connection_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string", "minLength": 1 }
      }
    },
    "resourceTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources"],
      "properties": {
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "macroStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call"],
      "properties": {
        "call": { "type": "string", "minLength": 1 },
        "args": { "type": "array" }
      }
    },
    "driverConfig": {
      "type": "object",
      "additionalProperties": true,
      "required": ["macros"],
      "properties": {
        "macros": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/macroStep" }
          }
        }
      }
    },
    "stageOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "occurrence"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "occurrence": { "enum": ["first", "last"] }
      }
    },
    "recipeImportResourceHold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id",
        "resource_ref",
        "scope",
        "acquire",
        "release"
      ],
      "properties": {
        "hold_id": { "type": "string", "minLength": 1 },
        "resource_ref": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["until_handoff", "workflow_block"] },
        "acquire": { "$ref": "#/$defs/stageOccurrence" },
        "release": { "$ref": "#/$defs/stageOccurrence" }
      }
    },
    "workflowImporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "codec"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "codec": { "type": "string", "minLength": 1 }
      }
    }
  }
}
